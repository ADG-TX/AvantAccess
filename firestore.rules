rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── GOTA HVAC unit data ────────────────────────────────────────
    match /units/{unitId} {
      allow read, write: if request.auth != null;
    }

    // ── Clubhouse, site photos, and other property-level data ──────
    match /properties/{propId} {
      allow read, write: if request.auth != null;
    }

    // ── Maintenance plan intake (brochure sign-ups) ───────────────
    // Public CREATE only, so an unauthenticated garage owner can submit the
    // form. Update and delete stay locked: with a blanket `write` a stranger
    // who guessed the collection could overwrite or wipe the whole intake
    // queue. Only the signed-in dashboard can modify or clear a request.
    match /intake_requests/{requestId} {
      allow read:            if request.auth != null;
      allow create:          if request.resource.data.size() < 30;
      allow update, delete:  if request.auth != null;
    }

  }
}
